# =============================================================================
# MomTest AI — Environment Variables Template
# =============================================================================
# Bu dosyayı .env.local olarak kopyalayın ve gerçek değerleri girin:
#   cp .env.example .env.local
#
# Podman/Docker kullanıyorsanız: docker-compose.yml içindeki env_file ayarı
# otomatik olarak .env.local dosyasını okur.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Container için: db servis adı, port 5432, credentials docker-compose.yml'de
DATABASE_URL=postgresql://momtest:momtest@db:5432/momtest

# Local development için (container kullanmıyorsanız):
# DATABASE_URL=postgresql://momtest:momtest@localhost:5432/momtest

# -----------------------------------------------------------------------------
# OpenAI API
# -----------------------------------------------------------------------------
# https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# -----------------------------------------------------------------------------
# Make.com Webhook URLs (isteğe bağlı)
# -----------------------------------------------------------------------------
# Mülakat tamamlandığında tetiklenen webhook
MAKE_WEBHOOK_INTERVIEW_URL=https://hook.eu2.make.com/your-interview-webhook-id

# Analiz tamamlandığında tetiklenen webhook
MAKE_WEBHOOK_ANALYSIS_URL=https://hook.eu2.make.com/your-analysis-webhook-id

# -----------------------------------------------------------------------------
# Node Environment (otomatik ayarlanır, isteğe bağlı override)
# -----------------------------------------------------------------------------
# NODE_ENV=production
