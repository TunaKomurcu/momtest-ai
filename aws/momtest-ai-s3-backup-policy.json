{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MomtestAiS3BackupObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::momtest-ai-storage-820140266422/*"
    },
    {
